# EDM CICS stack environment overrides
# Copy to .env and edit before first start.

# PostgreSQL credentials
POSTGRES_USER=bricks
POSTGRES_PASSWORD=brickspassword
POSTGRES_DB=bricks

# BRICKS_TS settings
BRICKS_enforce_secure_login=no
BRICKS_start_web3270=yes
BRICKS_web3270_port=9000

# Auto-apply EDM DDL on first start (requires psql in bricks image)
# BRICKS_auto_init_sql=/srv/bricks/sql/EDM-DDL.sql

# PostgREST settings
# PGRST_JWT_SECRET must be at least 32 chars for HS256
PGRST_JWT_SECRET=change-this-to-a-random-32-char-secret
