[Volume]
# Backed by ZFS dataset: storage/containers/edm-postgres
# Pre-create:
#   zfs create storage/containers/edm-postgres
#   podman volume create --opt type=none --opt o=bind \
#     --opt device=/storage/containers/edm-postgres edm-pgdata

Driver=local
Options=type=none,o=bind,device=/storage/containers/edm-postgres

[Install]
WantedBy=default.target
