[Unit]
Description=EDM BRICKS_TS transaction server
After=edm-postgres.service
Requires=edm-postgres.service

[Container]
# Pull from ghcr.io -- built and pushed by .github/workflows/build.yml
# on every commit to master that touches the bricks/ submodule.
Image=ghcr.io/denzuko/bricks_ts:latest
ContainerName=edm-bricks

# Credentials: postgres vars map to BRICKS db_* config via entrypoint.sh
EnvironmentFile=%h/.config/containers/edm.env
Environment=POSTGRES_HOST=edm-postgres
Environment=POSTGRES_USER=bricks
Environment=POSTGRES_DB=bricks
Environment=BRICKS_start_web3270=yes
Environment=BRICKS_web3270_port=9000

# Bind-mount EDM COBOL/REXX source and SQL DDL (read-only)
Volume=%h/edm-cics-quadlet/edm-cics/runtime:/srv/bricks/runtime:ro,Z
Volume=%h/edm-cics-quadlet/edm-cics/sql:/srv/bricks/sql:ro,Z

# Persistent BRICKS data (bbolt files, TS queues)
Volume=edm-bricks-data.volume:/srv/bricks/data:Z

# Port bindings
PublishPort=2300:2300
PublishPort=9000:9000

# Internal network for Postgres communication
Network=edm-cics.network

[Service]
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=edm-cics.target
