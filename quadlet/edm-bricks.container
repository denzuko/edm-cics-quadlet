[Unit]
Description=EDM BRICKS_TS transaction server
After=edm-postgres.service edm-bricks-data-volume.service
Requires=edm-postgres.service

[Container]
Image=ghcr.io/denzuko/bricks_ts:latest
ContainerName=edm-bricks

# Auto-update from ghcr.io on systemctl --user start
# Run: podman auto-update to pull latest and restart
AutoUpdate=registry

EnvironmentFile=%h/.config/containers/edm.env
Environment=POSTGRES_HOST=edm-postgres
Environment=POSTGRES_USER=bricks
Environment=POSTGRES_DB=bricks
Environment=BRICKS_start_web3270=yes
Environment=BRICKS_web3270_port=9000

# Runtime source: named volume backed by ZFS dataset
# storage/users/edm-runtime (read-write for operator edits)
# Pre-create: zfs create storage/users/edm-runtime
#             populate with edm-cics repo contents
#             podman volume create --opt type=none --opt o=bind \
#               --opt device=/storage/users/edm-runtime edm-runtime
Volume=edm-runtime.volume:/srv/bricks/runtime:Z

# SQL DDL: named volume backed by ZFS dataset storage/users/edm-sql
Volume=edm-sql.volume:/srv/bricks/sql:ro,Z

# Persistent BRICKS data: bbolt files, TS queues
# storage/containers/edm-bricks
Volume=edm-bricks-data.volume:/srv/bricks/data:Z

# Internal only — HAProxy terminates TLS externally on 2300/9000
# and forwards to these internal ports
PublishPort=127.0.0.1:2300:2300
PublishPort=127.0.0.1:9000:9000

Network=edm-cics.network

# net.matrix CMDB identity labels — Change Item attribution
Label=net.matrix.organization=daplanet
Label=net.matrix.orgunit=dps
Label=net.matrix.owner=FC13F74B@matrix.net
Label=net.matrix.oid=iso.org.dod.internet.42387
Label=net.matrix.duns=iso.org.duns.039271257
Label=net.matrix.customer=PVT-01
Label=net.matrix.costcenter=INT-01
Label=net.matrix.environment=production
Label=net.matrix.application=edm-cics-quadlet
Label=net.matrix.role=bricks-frontend

[Service]
Restart=on-failure
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=edm-cics.target
