[Unit]
Description=EDM PostgreSQL database
After=edm-cics-network.service edm-pgdata-volume.service
Requires=edm-cics-network.service edm-pgdata-volume.service

[Container]
Image=docker.io/postgres:16-alpine
ContainerName=edm-postgres

# Credentials from drop-in env file — never inline passwords
EnvironmentFile=%h/.config/containers/edm.env

# Named volume backed by ZFS dataset storage/containers/edm-postgres
# Pre-create: zfs create storage/containers/edm-postgres
#             podman volume create --opt type=none --opt o=bind \
#               --opt device=/storage/containers/edm-postgres edm-pgdata
Volume=edm-pgdata.volume:/var/lib/postgresql/data:Z

# Bootstrap SQL: postgres official image runs *.sql from
# /docker-entrypoint-initdb.d/ on first start against a fresh volume.
# Bind-mount the EDM sql/ directory (from edm-cics submodule) here.
# Files run in filename order: EDM-DDL.sql -> EDM-HELPDESK.sql ->
# EDM-MAILQ.sql -> EDM-DPR.sql
# On subsequent starts (volume already populated) initdb is skipped.
Volume=%h/edm-cics-quadlet/edm-cics/sql:/docker-entrypoint-initdb.d:ro,Z

Network=edm-cics.network

HealthCmd=pg_isready -U bricks -d bricks
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=30s

# No published ports — Postgres is internal only
# HAProxy handles external TLS if needed

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120

[Install]
WantedBy=edm-cics.target
